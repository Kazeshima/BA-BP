{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BA Draft Tool",
  "version": "../package.json",
  "identifier": "com.badraft.tool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BA Draft Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=HardwareMediaKeyHandling,OverlayScrollbar --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://schaledb.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://schaledb.com https://api.github.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kazeshima",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Blue Archive PvP ban/pick draft tool",
    "homepage": "https://github.com/Kazeshima/BA-BP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
